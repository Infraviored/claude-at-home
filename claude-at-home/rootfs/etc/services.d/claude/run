#!/usr/bin/with-contenv bashio
# ==============================================================================
# The Claude daemon, in the foreground: it holds every background session
# (`claude --bg`) -- the main one, which the claude-main service keeps up, and
# any a Claude Voice dashboard starts. This script IS the s6-supervised
# process; if the daemon dies, s6 runs it again and its sessions come back
# through claude-main.
# ==============================================================================
set -u
# shellcheck source=/dev/null
source /usr/lib/claude-at-home/common.sh

readonly SEED_HOME=/opt/claude-home

# First run: seed the CLI baked into the image into /data. No download.
if [ ! -x /data/.local/bin/claude ]; then
    bashio::log.info "Seeding Claude Code CLI into /data..."
    mkdir -p /data/.local
    cp -a "${SEED_HOME}/.local/." /data/.local/
fi

# Up to 1.4 the session lived in tmux on this socket. That tmux server died
# with the old container; its conversation is picked up by claude-main.
rm -f /data/tmux.sock

mkdir -p /data/.claude
bashio::log.info "Starting the Claude daemon..."
exec claude daemon run \
    --json-path /data/.claude/daemon.json \
    --log-file /data/.claude/daemon.log
